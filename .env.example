# ==========================================
# Expo app (bundled — EXPO_PUBLIC_* is embedded in shipped clients)
# ==========================================

# RapidAPI — default application key (Streaming Availability native path; Film & Show where used).
# Prefer the same subscribed account as Streaming Availability unless Product documents otherwise.
EXPO_PUBLIC_RAPIDAPI_KEY=

# Film & Show / RapidAPI ratings hub — X-RapidAPI-Host (e.g. film-show-ratings.p.rapidapi.com).
EXPO_PUBLIC_RAPIDAPI_HOST=

# Optional alias used in docs/API-ENDPOINTS checklist — grep lib/ before relying on rename.
# EXPO_PUBLIC_RAPIDAPI_FILMSHOW_HOST=
# Optional path override (default /top-100-items).
# EXPO_PUBLIC_RAPIDAPI_FILMSHOW_TOP_PATH=/top-100-items

# TMDB — client-side JSON (Discover, Home, Search, Watchlist, Watched, Person, Movie detail, enrich paths).
# Typically a read token / API key per TMDB dashboard.
EXPO_PUBLIC_TMDB_API_KEY=

# OMDb — optional ratings UI (see lib/ratings.ts).
# EXPO_PUBLIC_OMDB_API_KEY=

# Supabase — public project URL and anon key (Dashboard → Project Settings → API).
# MUST be https; do not use localhost on physical devices or TV.
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==========================================
# Vercel / server-only (never EXPO_PUBLIC_) — app/api/*+api.ts and api/streaming.ts on deploy
# ==========================================
# TMDB key for server routes (app/api/movie+api.ts, discover+api.ts, search+api.ts, providers+api.ts).
# Can match EXPO_PUBLIC_TMDB_API_KEY or be a separate server credential per ops policy.
# TMDB_API_KEY=

# RapidAPI key for Vercel serverless proxy (api/streaming.ts) — keeps key off browser when used.
# RAPIDAPI_KEY=

# ==========================================
# Stream Finder API → Supabase sync & audits (Node / scripts only — not the Expo client bundle)
# ==========================================
STREAM_FINDER_KEY=
# Optional override; default is the Replit deployment documented in docs/API-ENDPOINTS.md.
# STREAM_FINDER_MOVIES_URL=https://stream-finder--trevorseitzai.replit.app/api/movies

# Same project as EXPO_PUBLIC_SUPABASE_URL; scripts that load dotenv often read SUPABASE_URL.
SUPABASE_URL=your_supabase_url_here

# Service role — bypasses RLS. Trusted machines / CI only. Never ship in the app.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ==========================================
# QA report email (scripts/generate-qa-report.ts — optional)
# ==========================================
# RESEND_API_KEY=
# REPORT_EMAIL=
# RESEND_FROM=

# ==========================================
# Maestro E2E (host shell / CI only — not read by the Expo app)
# ==========================================
# maestro test -e MAESTRO_TEST_USER_EMAIL="..." -e MAESTRO_TEST_USER_PASSWORD="..."
# MAESTRO_TEST_USER_EMAIL=
# MAESTRO_TEST_USER_PASSWORD=
